#!/usr/bin/env bash
set -euo pipefail

cd -- "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r -d '' file; do
  case "$file" in
    lib/generated/*|*.g.dart|*.freezed.dart|*.pb.dart|*.pbenum.dart|*.pbjson.dart) ;;
    *.dart) files+=("$file") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#files[@]} == 0)); then exit 0; fi
dart_bin=${DART_BIN:-}
if [[ -z $dart_bin ]] && command -v dart >/dev/null 2>&1; then
  dart_bin=$(command -v dart)
fi
if [[ -z $dart_bin && -n ${FLUTTER_ROOT:-} && -x ${FLUTTER_ROOT}/bin/cache/dart-sdk/bin/dart ]]; then
  dart_bin=${FLUTTER_ROOT}/bin/cache/dart-sdk/bin/dart
fi
if [[ -z $dart_bin && -f android/local.properties ]]; then
  while IFS='=' read -r key value; do
    if [[ $key == flutter.sdk && -x $value/bin/cache/dart-sdk/bin/dart ]]; then
      dart_bin=$value/bin/cache/dart-sdk/bin/dart
      break
    fi
  done < android/local.properties
fi
if [[ -z $dart_bin || ! -x $dart_bin ]]; then
  printf 'pre-commit: Dart SDK not found. Add dart to PATH or set DART_BIN or FLUTTER_ROOT.\n' >&2
  exit 1
fi

for file in "${files[@]}"; do
  entry=$(git ls-files --stage -- "$file")
  mode=${entry:0:6}
  [[ $mode == 100644 || $mode == 100755 ]] || continue
  original=$(git rev-parse --verify ":$file")
  clean=true
  git diff --quiet --no-ext-diff -- "$file" || clean=false
  formatted=$(git show ":$file" | "$dart_bin" format --output show --summary none --stdin-name "$file" | git hash-object -w --stdin)
  if [[ $formatted != "$original" ]]; then
    git update-index --cacheinfo "$mode,$formatted,$file"
    if $clean; then
      git checkout-index --force -- "$file"
    else
      printf 'pre-commit: formatted staged %s; unstaged edits were left untouched.\n' "$file" >&2
    fi
    printf 'pre-commit: formatted %s\n' "$file"
  fi
done
